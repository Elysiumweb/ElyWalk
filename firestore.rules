rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function auth() { return request.auth != null; }
    function self(uid) { return auth() && request.auth.uid == uid; }
    function verified() { return auth() && request.auth.token.email_verified == true; }
    function president() { return auth() && request.auth.uid in ['BZ333LlhuJMoD4rXIquGE0zzjX43','7XLpqYMKEMX5kLrQtts6NG3zRB32']; }
    function numberBetween(value, low, high) { return value is number && value >= low && value <= high; }
    // Blocage pour les **écritures** (et les interactions serveur) : la table
    // `blockedAccounts` est la source de vérité, elle est toujours à jour — donc
    // aucune dépendance à la migration du blob. Coût : 2 `exists()`.
    // Ces fonctions ne doivent **jamais** être appelées depuis un `allow list` :
    // le coût serait payé par ligne et Firestore refuserait la requête au 11e
    // résultat.
    function blockPath(owner, target) { return /databases/$(database)/documents/blockedAccounts/$(owner + '_' + target); }
    function blocked(a, b) { return exists(blockPath(a, b)) || exists(blockPath(b, a)); }
    function canInteract(a, b) { return a != b && !blocked(a, b); }
    // F01 — l'audience « Amis » ne se contente plus de la visibilité déclarée :
    // l'amitié est vérifiée côté serveur sur le document `friendships`.
    function friendId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(a, b) {
      return a != b && exists(/databases/$(database)/documents/friendships/$(friendId(a, b)));
    }
    // Amitié **visible** de `viewer` : utilisable dans un `allow list`, car le
    // coût est d'un seul `get()` sur le document dont l'identifiant est fixe
    // (aucune lecture par ligne). Une amitié masquée par un blocage (`hiddenFor`)
    // n'ouvre plus l'accès aux sorties de l'autre.
    function friendshipVisible(viewer, owner) {
      return viewer != owner
        && !('hiddenFor' in get(/databases/$(database)/documents/friendships/$(friendId(viewer, owner))).data
          && viewer in get(/databases/$(database)/documents/friendships/$(friendId(viewer, owner))).data.hiddenFor);
    }
    // Champs strictement privés : jamais exposés par le document `users`.
    // (Les signaux antifraude vivent dans `users/{uid}/private/signals`.)
    //
    // F01 — un lien de partage est un document `shareLinks/<sessionId>_<uid>` :
    // l'identifiant est déterministe, ce qui permet de le lire sans requête sur
    // un champ, et sa suppression révoque l'accès immédiatement. Il ne contient
    // que le résumé explicitement partagé, jamais le tracé GPS.
    function linkPath(sessionId, uid) {
      return /databases/$(database)/documents/shareLinks/$(sessionId + '_' + uid);
    }
    function linkIsActive(sessionId, owner) {
      return exists(linkPath(sessionId, owner));
    }
    // F01/F07 — blocage : zéro appel de document sur le chemin nominal.
    //
    // ⚠️ Firestore plafonne une requête à **10 appels `get()`/`exists()` au
    // total**, pas par ligne. Une règle de liste qui lit un document tiers coûte
    // 1 appel par ligne : au 11e résultat, la requête entière est refusée.
    // C'est ce qui vidait le classement (2.2.0) et faisait boucler le
    // chargement des amis (2.2.1), où `friendships` et `directMessages`
    // vérifiaient encore le blocage avant d'être lus.
    //
    // Le blocage est donc dénormalisé **dans le document lu** :
    //  • `users.blockedBy`   — qui m'a bloqué (écrit chez moi par l'autre) ;
    //  • `users.blockedUsers` — qui j'ai bloqué ;
    //  • `friendships.hiddenFor`, `friendRequests.fromBlocked`, `directMessages.fromBlocked`.
    // Ces champs ne contiennent que des **identifiants**, jamais de nom, et ne
    // sont lisibles que par les personnes déjà autorisées à lire le document.
    //
    // Un profil créé avant la 2.2.2 n'a pas `blockedBy` : il est alors traité
    // comme non bloquant (repli explicite, `backfillBlockedUsers` le renseigne).
    // Une liste est donc *au pire* trop permissive pendant la migration, jamais
    // refusée — contrairement au `get()` par ligne, qui cassait tout.
    function profilePath(profileUid) {
      return /databases/$(database)/documents/users/$(profileUid);
    }
    function profileExists(profileUid) {
      return exists(profilePath(profileUid));
    }
    // Un profil sans `blockedUsers` (créé avant la 2.2.2) n'est jamais
    // considéré comme bloquant : on échoue ouvert plutôt que de casser la
    // lecture, et `backfillBlockedUsers` comble le trou.
    function notBlockedByMe(uid, otherUid) {
      return !profileExists(uid)
        || !('blockedUsers' in get(profilePath(uid)).data)
        || !(otherUid in get(profilePath(uid)).data.blockedUsers);
    }
    // Coût : 2 `get` (les appels redondants sur le même document sont mis en
    // cache). Réservé aux lectures **unitaires** (`allow get`) et aux écritures.
    function mutuallyNotBlocked(a, b) {
      return a == b || (notBlockedByMe(a, b) && notBlockedByMe(b, a));
    }
    // Lecture publique d'un profil : autorisée sauf si son propriétaire a bloqué
    // le lecteur. Aucun `get()` : `blockedBy` est dans le document évalué, coût
    // nul quelle que soit la taille de la requête.
    function notListHidden() {
      return !('blockedBy' in resource.data) || !(request.auth.uid in resource.data.blockedBy);
    }
    function participantsAllowed(p) {
      // Le créateur est toujours p[0] dans le service. Limite volontaire à six
      // participants pour rester sous le quota de lectures des règles.
      return canInteract(p[0], p[1])
        && (p.size() < 3 || canInteract(p[0], p[2]))
        && (p.size() < 4 || canInteract(p[0], p[3]))
        && (p.size() < 5 || canInteract(p[0], p[4]))
        && (p.size() < 6 || canInteract(p[0], p[5]));
    }
    function validEventMembership(before, after, uid) {
      let oldWaitlist = before.keys().hasAny(['waitlist']) ? before.waitlist : [];
      let addedP = after.participants.toSet().difference(before.participants.toSet());
      let removedP = before.participants.toSet().difference(after.participants.toSet());
      let addedW = after.waitlist.toSet().difference(oldWaitlist.toSet());
      let removedW = oldWaitlist.toSet().difference(after.waitlist.toSet());
      let ownChange = addedP.hasOnly([uid]) && removedP.hasOnly([uid]) && addedW.hasOnly([uid]) && removedW.hasOnly([uid])
        && addedP.size() <= 1 && removedP.size() <= 1 && addedW.size() <= 1 && removedW.size() <= 1;
      let promotion = removedP == [uid].toSet() && addedP.size() == 1 && addedW.size() == 0
        && addedP == removedW && removedW.size() == 1
        && after.participants.size() == before.participants.size();
      let unique = after.participants.size() == after.participants.toSet().size()
        && after.waitlist.size() == after.waitlist.toSet().size()
        && after.participants.toSet().intersection(after.waitlist.toSet()).size() == 0;
      let withinCapacity = !before.keys().hasAny(['maxParticipants']) || before.maxParticipants == null
        || after.participants.size() <= before.maxParticipants;
      let waitlistOnlyWhenFull = addedW.size() == 0 || (before.keys().hasAny(['maxParticipants']) && before.maxParticipants != null && before.participants.size() >= before.maxParticipants);
      return unique && withinCapacity && waitlistOnlyWhenFull && (ownChange || promotion);
    }
    function economyUnchanged() {
      return request.resource.data.elycoins == resource.data.elycoins
        && request.resource.data.totalSteps == resource.data.totalSteps
        && request.resource.data.totalCalories == resource.data.totalCalories
        && request.resource.data.streak == resource.data.streak
        && request.resource.data.lastValidatedDate == resource.data.lastValidatedDate;
    }
    function safePublicSync() {
      return economyUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['todaySteps','todayDate'])
        && numberBetween(request.resource.data.todaySteps, 0, 60000);
    }
    // Le blob de blocage n'est modifiable que par le propriétaire, et uniquement
    // par ajout/retrait d'un identifiant : on ne peut pas réécrire la liste pour
    // masquer un blocage existant sans le supprimer réellement.
    function blockedListDeltaOk() {
      // Un seul ajout **et** un seul retrait par écriture : impossible de
      // réécrire la liste d'un coup pour masquer un blocage existant.
      // `keys().hasAny` avant toute lecture : un profil créé avant la 2.2.2 n'a
      // pas `blockedUsers`, et lire une clé absente fait échouer l'évaluation
      // (donc refuser l'écriture) au lieu de renvoyer `false`.
      let before = resource.data.keys().hasAny(['blockedUsers']) ? resource.data.blockedUsers : [];
      return request.resource.data.blockedUsers.size() <= 200
        && before.toSet().difference(request.resource.data.blockedUsers.toSet()).size() <= 1
        && request.resource.data.blockedUsers.toSet().difference(before.toSet()).size() <= 1;
    }
    function safeBlockedUsersSync() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedUsers'])
        && request.resource.data.blockedUsers is list
        && blockedListDeltaOk();
    }
    // `blockedBy` est écrit **chez l'autre** : il ne peut recevoir qu'un seul
    // identifiant, celui de l'auteur de l'écriture. On ne peut donc pas accuser
    // quelqu'un d'avoir bloqué, seulement déclarer son propre blocage.
    function safeBlockedBySync(targetUid) {
      // L'identifiant est passé en paramètre : s'appuyer sur la variable `{uid}`
      // du `match` englobant déclenche l'avertissement de compilation
      // « Invalid variable name: uid » et rend la règle illisible.
      // `blockedBy` est absent des profils créés avant la 2.2.2 : on exige qu'il
      // existe déjà, pour n'autoriser qu'un ajout ou un retrait.
      return request.auth.uid != targetUid
        && resource.data.keys().hasAny(['blockedBy'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedBy'])
        && request.resource.data.blockedBy is list
        && request.resource.data.blockedBy.size() <= 200
        && request.resource.data.blockedBy.toSet().difference(resource.data.blockedBy.toSet()) == [request.auth.uid].toSet()
        && resource.data.blockedBy.toSet().difference(request.resource.data.blockedBy.toSet()).size() <= 1;
    }
    // Initialisation à l'inscription : tableaux vides obligatoires.
    function initialBlockedUsers() {
      return (!('blockedUsers' in request.resource.data) || request.resource.data.blockedUsers == [])
        && (!('blockedBy' in request.resource.data) || request.resource.data.blockedBy == []);
    }
    // `blockedBy` est écrit **par un tiers** sur mon profil : ce champ ne doit pas
    // pouvoir accompagner une modification personnelle, sinon n'importe qui
    // pourrait se déclarer bloqué par quelqu'un d'autre. Il n'est modifiable que
    // par `safeBlockedBySync`, dans une écriture qui ne touche que lui.
    function withoutBlockedBy() {
      let before = resource.data.keys().hasAny(['blockedBy']) ? resource.data.blockedBy : [];
      return !('blockedBy' in request.resource.data)
        || request.resource.data.blockedBy == before;
    }
    function safeProfileEdit() {
      // `blockedUsers` rejoint la liste des champs autorisés : `blockAccount`
      // tient le blocage et la liste dans une **seule** écriture atomique
      // (`writeBatch`), donc plus de risque qu'un retrait soit perdu parce que
      // la seconde écriture a échoué.
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return economyUnchanged() && withoutBlockedBy() && changed.hasOnly([
        'displayName','photoURL','paypalEmail','referredBy','referralRejected','signupIp','lastIp','hwid','hwids',
        'dailyStepGoal','strideLengthCm','bio','onboardingDone','todaySteps','todayDate','health','unitSystem','activityPrivacy','blockedUsers',
        // Alertes : préférences (dont le rayon des rencontres proches) et
        // dernière position approximative, utilisées par le cron pour envoyer
        // une alerte de rencontre dans le rayon choisi. Ces champs ne
        // contiennent aucun identifiant et sont bornés dans `validAlertFields()`.
        'alerts','lastLat','lastLng'
      ]) && numberBetween(request.resource.data.todaySteps, 0, 60000)
        && validAlertFields()
        // Lorsque la liste accompagne une modification de profil, seul le delta
        // est contrôlé (une entrée ajoutée ou retirée), pas la forme complète.
        && (!changed.hasAny(['blockedUsers'])
          || (request.resource.data.blockedUsers is list && blockedListDeltaOk()));
    }
    // Préférences d'alerte et position approximative (rayon des rencontres).
    // Borne explicite : le cron lit ces valeurs pour décider d'un envoi.
    function validAlertFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['alerts'])
          || (request.resource.data.alerts is map
            && request.resource.data.alerts.keys().hasOnly([
              'messages','friendRequests','nearbyEvents','nearbyRadiusKm',
              'eventReminders','eventReminderMinutes','updatedAt'
            ])
            && request.resource.data.alerts.nearbyRadiusKm is number
            && numberBetween(request.resource.data.alerts.nearbyRadiusKm, 1, 100)
            && request.resource.data.alerts.eventReminderMinutes is number
            && numberBetween(request.resource.data.alerts.eventReminderMinutes, 5, 1440)))
        && (!changed.hasAny(['lastLat'])
          || (request.resource.data.lastLat is number && numberBetween(request.resource.data.lastLat, -90, 90)))
        && (!changed.hasAny(['lastLng'])
          || (request.resource.data.lastLng is number && numberBetween(request.resource.data.lastLng, -180, 180)));
    }
    function validStepCredit(uid) {
      let day = request.resource.data.lastValidatedDate;
      let daily = getAfter(/databases/$(database)/documents/users/$(uid)/dailySteps/$(day)).data;
      return verified() && day != resource.data.lastValidatedDate
        && daily.steps is int && numberBetween(daily.steps, 0, 60000)
        && request.resource.data.totalSteps == resource.data.totalSteps + daily.steps
        && request.resource.data.totalCalories == resource.data.totalCalories + daily.calories
        && request.resource.data.elycoins == resource.data.elycoins + daily.coins
        && request.resource.data.todaySteps == daily.steps
        && request.resource.data.streakFreezes is int
        && request.resource.data.streakFreezes >= 0
        && request.resource.data.streakFreezes <= 1;
    }
    function validAdCredit(uid) {
      let slot = request.resource.data.lastAdSlot;
      let claim = getAfter(/databases/$(database)/documents/adClaims/$(slot)).data;
      return verified() && (!('lastAdSlot' in resource.data) || slot != resource.data.lastAdSlot) && claim.uid == uid && claim.coins == 0.1
        && request.resource.data.lastAdRewardAt == request.time
        && (!('lastAdRewardAt' in resource.data) || request.time > resource.data.lastAdRewardAt + duration.value(1, 'h'))
        && request.resource.data.elycoins == resource.data.elycoins + 0.1
        && request.resource.data.totalSteps == resource.data.totalSteps
        && request.resource.data.totalCalories == resource.data.totalCalories;
    }
    function validReferralCredit(uid) {
      let claimId = request.resource.data.lastReferralClaim;
      let before = get(/databases/$(database)/documents/referralClaims/$(claimId)).data;
      let after = getAfter(/databases/$(database)/documents/referralClaims/$(claimId)).data;
      return verified() && (!('lastReferralClaim' in resource.data) || claimId != resource.data.lastReferralClaim) && before.claimed == false && after.claimed == true
        && after.sponsorUid == uid && request.resource.data.elycoins == resource.data.elycoins + 10
        && request.resource.data.totalSteps == resource.data.totalSteps;
    }
    // Un utilisateur peut dépenser son solde, jamais le créditer librement. La création
    // atomique du retrait est contrôlée dans /withdrawals.
    function validChallengeCredit(uid) {
      let challengeId = request.resource.data.lastChallengeClaim;
      let before = get(/databases/$(database)/documents/users/$(uid)/challenges/$(challengeId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(uid)/challenges/$(challengeId)).data;
      // F02 — la récompense doit venir d'une campagne connue du catalogue
      // autoritaire (`challengeCatalog`, écrit uniquement par l'administration) :
      // un défi inventé ou un montant arbitraire ne peuvent pas être crédités.
      let catalog = get(/databases/$(database)/documents/challengeCatalog/$(challengeId)).data;
      return verified() && (!('lastChallengeClaim' in resource.data) || challengeId != resource.data.lastChallengeClaim)
        && after.claimed == true && after.uid == uid
        && before.claimed == false
        && catalog.active == true
        && numberBetween(after.reward, 1, 50)
        && after.reward == catalog.reward
        && request.resource.data.elycoins == resource.data.elycoins + after.reward
        && request.resource.data.totalSteps == resource.data.totalSteps
        && request.resource.data.totalCalories == resource.data.totalCalories
        && request.resource.data.streak == resource.data.streak
        && request.resource.data.lastValidatedDate == resource.data.lastValidatedDate;
    }
    function validDebit() {
      return verified() && request.resource.data.elycoins >= 0
        && request.resource.data.elycoins < resource.data.elycoins
        && request.resource.data.totalSteps == resource.data.totalSteps
        && request.resource.data.totalCalories == resource.data.totalCalories;
    }

    match /blockedAccounts/{id} {
      // Lecture par le président : indispensable à `backfillBlockedUsers`, qui
      // reconstruit `users.blockedUsers` pour les profils antérieurs à la 2.2.2.
      allow read: if auth() && (resource.data.ownerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid || president());
      allow create: if auth() && id == request.auth.uid + '_' + request.resource.data.blockedUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.blockedName.size() <= 80;
      allow delete: if auth() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
    match /reports/{id} {
      allow read: if president() || (auth() && resource.data.reporterUid == request.auth.uid);
      allow create: if auth() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetType in ['profile','message','activity','event']
        && request.resource.data.reason in ['harassment','spam','inappropriate','safety','other']
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.history == [];
      allow update: if president()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','history','updatedAt'])
        && request.resource.data.status in ['open','reviewing','resolved','dismissed']
        && request.resource.data.history.size() <= 100;
      allow delete: if false;
    }

    match /users/{uid} {
      // F01 — la lecture d'un profil tiers reste possible (classement, amis,
      // recherche par code) mais **bornée** : une requête de collection est
      // plafonnée à 200 documents, impossible donc d'aspirer toute la base. Les
      // champs sensibles (e-mail, PayPal, IP, HWID, santé) vivent dans `private`
      // et dans les documents de retrait, jamais dans le document public.
      //
      // Blocage via la liste du profil (2 `get` au plus) :
      // sous le budget de 10 appels par requête. `list` reste plafonné à 200
      // documents, donc aucun balayage complet de la base.
      allow get: if self(uid) || president()
        || (auth() && mutuallyNotBlocked(request.auth.uid, uid));
      // Coût : 0 appel de document. `self(uid)` n'évalue aucun document ; le
      // reste ne lit que le document candidat. Une requête de 200 profils passe
      // donc, et un profil bloqué est filtré sans casser la requête.
      allow list: if self(uid) || president()
        || (auth() && request.query.limit <= 200
          && (resource.data.uid == request.auth.uid || notListHidden()));
      allow create: if self(uid) && request.resource.data.uid == uid
        && request.resource.data.elycoins == 0 && request.resource.data.totalSteps == 0
        && initialBlockedUsers();
      allow update: if president() || (self(uid) && (safeProfileEdit() || safeBlockedUsersSync() || safePublicSync() || validStepCredit(uid) || validAdCredit(uid) || validReferralCredit(uid) || validChallengeCredit(uid) || validDebit()))
        // Un tiers ne peut écrire que `blockedBy`, et seulement son propre
        // identifiant : c'est ainsi qu'un blocage devient visible des listes.
        || (auth() && safeBlockedBySync(uid));
      allow delete: if self(uid);
      match /dailySteps/{day} {
        // F01 — les pas quotidiens ne sont plus librement énumérables.
        //  • propriétaire, amis vérifiés, présidents : accès complet (historique) ;
        //  • tout autre utilisateur : uniquement par fenêtre bornée (≤ 31 jours),
        //    ce qui couvre le classement 7 / 30 jours et les cartes de profil
        //    sans permettre de reconstituer un historique complet ni de balayer
        //    la sous-collection.
        // Pas de contrôle de blocage sur les pas quotidiens : une fenêtre de
        // 30 jours coûterait 30 à 60 appels de document pour une seule requête,
        // donc tout l'historique d'autrui serait refusé et les colonnes
        // « 7 / 30 jours » du classement resteraient à zéro. Les pas agrégés ne
        // contiennent aucune localisation ; le blocage ferme les sorties GPS.
        allow get: if self(uid) || president() || areFriends(request.auth.uid, uid)
          || auth();
        allow list: if self(uid) || president() || areFriends(request.auth.uid, uid)
          || (auth() && request.query.limit <= 31);
        allow create: if self(uid) && verified()
          && request.resource.data.steps is int && numberBetween(request.resource.data.steps, 0, 60000)
          && numberBetween(request.resource.data.coins, 1, 50);
        allow update, delete: if false;
      }
      match /notificationTokens/{tokenId} {
        allow read, create, update, delete: if self(uid);
      }
      // F01 — notes privées des sorties : lisibles par le seul propriétaire,
      // jamais renvoyées avec le document partageable.
      match /privateActivityNotes/{sessionId} {
        allow read, create, update, delete: if self(uid);
      }
      // F01 — signaux antifraude (IP, HWID) isolés du profil : seul le
      // propriétaire écrit, les présidents consultent en cas de litige.
      match /private/{docId} {
        allow read: if self(uid) || president();
        allow write: if self(uid);
      }
      match /challenges/{challengeId} {
        allow read: if self(uid);
        // F02 — la progression et la récompense ne sont plus libres : montant
        // borné au barème (`rewardBetween`), progression bornée à 400 000
        // unités (le plus grand objectif de campagne), `claimed` seul champ
        // modifiable après création. Le montant est aussi comparé au barème du
        // catalogue côté fonctions d'administration.
        allow create: if self(uid) && verified()
          && request.resource.data.uid == uid
          && request.resource.data.progress is number
          && numberBetween(request.resource.data.progress, 0, 400000)
          && request.resource.data.claimed is bool
          && (!('reward' in request.resource.data) || numberBetween(request.resource.data.reward, 0, 50));
        allow update: if self(uid) && verified()
          && request.resource.data.uid == uid
          && numberBetween(request.resource.data.progress, 0, 400000)
          && request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimed','progress','updatedAt','claimedAt','reward'])
          && request.resource.data.claimed is bool
          && (!('reward' in request.resource.data) || (
            numberBetween(request.resource.data.reward, 0, 50)
            && (!('reward' in resource.data) || request.resource.data.reward == resource.data.reward)));
        allow delete: if self(uid);
      }
      match /transactions/{txId} {
        allow read: if self(uid) || president();
        // F02 — le registre des crédits reste lisible par le propriétaire, mais
        // un client ne peut plus s'auto-créditer en inscrivant une ligne
        // « challenge » : seuls les types issus d'un flux vérifié
        // (pas, publicité, parrainage) et les débits sont acceptés côté client.
        // Les crédits de défi passent par le Worker / l'administration.
        allow create: if president() || (self(uid) && verified()
          && numberBetween(request.resource.data.coins, -10000000, 50)
          && request.resource.data.createdAt is number
          && !(request.resource.data.type == 'challenge' && request.resource.data.coins > 0));
        allow delete: if self(uid); // suppression RGPD uniquement, aucune incidence sur le solde
        allow update: if false;
      }
    }

    // Version publiée sur le Play Store (écran de mise à jour au démarrage).
    //
    // Lecture : toute session authentifiée — l'écran de mise à jour doit pouvoir
    // s'afficher même avant l'onboarding. Écriture : président uniquement, et
    // uniquement les champs attendus, bornés. Aucune donnée personnelle ici.
    //
    // Les versions ne sont pas validées par une expression régulière : le
    // langage des règles n'accepte pas d'échappement `\.` fiable dans une chaîne,
    // et une regex invalide empêchait tout le fichier de compiler. La borne de
    // longueur suffit — le document est écrit par le président uniquement, et le
    // client (`decideUpdate`) ne propose jamais de mise à jour vers une valeur
    // qu'il ne sait pas comparer.
    match /appRelease/{docId} {
      allow read: if auth();
      allow write: if president()
        && docId == 'current'
        && request.resource.data.keys().hasOnly([
          'latestVersion','minSupportedVersion','notes','publishedAt','enabled','updatedAt'
        ])
        && request.resource.data.latestVersion is string
        && request.resource.data.latestVersion.size() <= 20
        && (!('minSupportedVersion' in request.resource.data)
          || (request.resource.data.minSupportedVersion is string
            && request.resource.data.minSupportedVersion.size() <= 20))
        && (!('notes' in request.resource.data)
          || (request.resource.data.notes is string && request.resource.data.notes.size() <= 600))
        && (!('enabled' in request.resource.data) || request.resource.data.enabled is bool);
    }

    // F01 — profil public séparé, projeté depuis `users` : c'est la seule vue
    // autorisée aux autres utilisateurs (pseudo, photo, bio, niveau, pas).
    // F02 — catalogue autoritaire des campagnes : montants et fenêtres de
    // validité définis par l'administration, jamais par le client.
    match /challengeCatalog/{challengeId} {
      allow read: if auth();
      allow write: if president();
    }

    // F01 — accès public à une sortie partagée par lien.
    //
    // Un lien porte sur un couple (sortie, propriétaire) : l'identifiant est
    // donc déterministe (`<sessionId>_<uid>`), ce qui évite toute requête sur un
    // champ depuis une règle. Un visiteur non authentifié ne peut pas lire
    // `activitySessions` (règle trop large) ; il lit ce document, qui ne contient
    // que le résumé explicitement partagé (titre, distance, durée, date) et le
    // périmètre du lien. Révoquer = supprimer ce document ; il cesse alors
    // instantanément d'exister pour tout le monde.
    match /shareLinks/{linkId} {
      // Lecture par identifiant uniquement : autoriser `list` permettrait
      // d'énumérer tous les liens partagés et de contourner le secret du jeton.
      allow get: if true;
      allow list: if false;
      allow create: if self(request.resource.data.ownerUid)
        && request.resource.data.ownerUid == get(/databases/$(database)/documents/activitySessions/$(request.resource.data.sessionId)).data.uid
        && request.resource.data.token.size() >= 16
        && request.resource.data.scope in ['summary','track']
        && (!('caption' in request.resource.data) || request.resource.data.caption.size() <= 500)
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 120)
        && request.resource.data.distanceM is number
        && request.resource.data.distanceM >= 0;
      allow update: if false;
      allow delete: if auth() && resource.data.ownerUid == request.auth.uid;
    }


    match /adClaims/{slot} {
      allow read: if auth();
      allow create: if verified() && request.resource.data.uid == request.auth.uid
        && request.resource.data.slot == slot && slot.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}$')
        && request.resource.data.coins == 0.1;
      allow update, delete: if false;
    }
    match /referralCodes/{code} {
      allow read: if auth(); allow create: if auth() && request.resource.data.uid == request.auth.uid;
      allow delete: if auth() && resource.data.uid == request.auth.uid; allow update: if false;
    }
    match /referralClaims/{referredUid} {
      allow read: if auth();
      allow create: if self(referredUid) && request.resource.data.referredUid == referredUid;
      allow update: if auth() && resource.data.sponsorUid == request.auth.uid && resource.data.claimed == false
        && request.resource.data.claimed == true;
      allow delete: if auth() && (referredUid == request.auth.uid || resource.data.sponsorUid == request.auth.uid);
    }
    match /friendRequests/{id} {
      allow read: if auth() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid)
        // `fromBlocked` est absent des documents créés par une version
        // antérieure : on ne le lit que s'il existe, sinon la règle échouerait
        // sur une clé manquante et refuserait la requête entière.
        && (!('fromBlocked' in resource.data) || !resource.data.fromBlocked);
      allow create: if auth() && request.resource.data.from == request.auth.uid
        && canInteract(request.resource.data.from, request.resource.data.to)
        && (!('fromBlocked' in request.resource.data) || request.resource.data.fromBlocked == false)
        && request.resource.data.status == 'pending';
      allow update: if auth() && resource.data.to == request.auth.uid && !blocked(resource.data.from, resource.data.to);
      allow delete: if auth() && request.auth.uid in [resource.data.from, resource.data.to];
    }
    match /friendReactions/{id} {
      // Coût : 0. Un encouragement d'un compte bloqué n'est jamais lisible, et
      // `fromBlocked` est figé à la création.
      allow read: if auth() && request.auth.uid in [resource.data.from, resource.data.to];
      allow create: if auth() && request.resource.data.from == request.auth.uid
        && canInteract(request.resource.data.from, request.resource.data.to)
        && request.resource.data.emoji in ['👏','🔥','💛','👋'] && request.resource.data.message.size() <= 160;
      allow delete: if auth() && request.auth.uid in [resource.data.from, resource.data.to]; allow update: if false;
    }
    match /friendships/{id} {
      // Coût : 0. `hiddenFor` est écrit par le service de blocage sur les
      // amitiés concernées ; une amitié non actualisée reste lisible une fois.
      // (`hiddenFor` peut manquer sur une amitié créée avant la 2.2.2.)
      allow read: if auth() && request.auth.uid in resource.data.members
        && !(resource.data.keys().hasAny(['hiddenFor']) && request.auth.uid in resource.data.hiddenFor);
      allow create: if auth() && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2
        && canInteract(request.resource.data.members[0], request.resource.data.members[1])
        && (!('hiddenFor' in request.resource.data) || request.resource.data.hiddenFor == []);
      allow delete: if auth() && request.auth.uid in resource.data.members;
      // F12 — un seul ajustement de `hiddenFor` par écriture, par un membre.
      // `hiddenFor` peut manquer sur une amitié créée avant la 2.2.2 : on le
      // traite alors comme vide (`keys().hasAny` évite l'erreur de clé).
      allow update: if auth() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        && request.resource.data.hiddenFor.toSet().difference(
          resource.data.keys().hasAny(['hiddenFor']) ? resource.data.hiddenFor.toSet() : [].toSet()).size() <= 1
        && (resource.data.keys().hasAny(['hiddenFor']) ? resource.data.hiddenFor.toSet() : [].toSet())
          .difference(request.resource.data.hiddenFor.toSet()).size() <= 1;
    }
    match /withdrawals/{id} {
      allow read: if president() || (auth() && resource.data.uid == request.auth.uid);
      allow create: if verified() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.coins is int
        && request.resource.data.coins > 0
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.elycoins
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.elycoins - request.resource.data.coins
        && !(request.resource.data.type in ['paypal','partner'] && president());
      allow update: if (auth() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName','paypalEmail','deletedUser'])
          && request.resource.data.userName == 'Compte supprimé' && request.resource.data.paypalEmail == null)
        || (president() && resource.data.status == 'pending'
        && request.resource.data.status in ['paid','rejected','received']
        && (request.resource.data.status != 'received' || resource.data.type == 'donation')
        && (request.resource.data.status != 'paid' || resource.data.type != 'donation')
        && (request.resource.data.status != 'rejected' ||
          getAfter(/databases/$(database)/documents/users/$(resource.data.uid)).data.elycoins
            == get(/databases/$(database)/documents/users/$(resource.data.uid)).data.elycoins + resource.data.coins));
      allow delete: if false;
    }
    match /activitySessions/{id} {
      // F01 — audiences formalisées et vérifiées côté serveur :
      //  • `private`  : propriétaire uniquement ;
      //  • `friends`  : amitié enregistrée **et** absence de blocage ;
      //  • `link`     : la sortie n'est plus lisible directement, l'accès passe
      //                 par un `shareLink` actif (jeton non devinable).
      // `allow get` garde le contrôle bilatéral complet (2 `exists` sur la table
      // des blocages, source de vérité) ; `allow list` utilise la version bon
      // marché, car une lecture par ligne ferait refuser la requête au 11e
      // document — c'est exactement ce qui cassait le classement et les amis.
      allow get: if auth() && (
        resource.data.uid == request.auth.uid
        || (resource.data.visibility == 'friends'
          && areFriends(request.auth.uid, resource.data.uid)
          && !blocked(request.auth.uid, resource.data.uid))
        || (resource.data.visibility == 'link'
          && !blocked(request.auth.uid, resource.data.uid)
          && linkIsActive(id, resource.data.uid))
      );
      allow list: if auth() && request.query.limit <= 100 && (
        resource.data.uid == request.auth.uid
        || (resource.data.visibility in ['friends','link']
          && friendshipVisible(request.auth.uid, resource.data.uid))
      );
      allow create: if verified() && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['walk','run'] && request.resource.data.status == 'active';
      // pausedSec est exclu de durationSec (durée active) et borné à 24 h.
      // title / caption / weather : bornes alignées sur l'interface.
      allow update: if verified() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points.size() <= 20000
        && request.resource.data.distanceM is number
        && request.resource.data.durationSec is number && request.resource.data.durationSec >= 0
        && request.resource.data.status in ['active','completed']
        && (!('pausedSec' in request.resource.data)
          || (request.resource.data.pausedSec is number
            && request.resource.data.pausedSec >= 0
            && request.resource.data.pausedSec <= 86400))
        && (!('title' in request.resource.data) || request.resource.data.title.size() <= 80)
        // F01 — la note privée n'appartient plus au document partageable.
        && !('note' in request.resource.data)
        && (!('caption' in request.resource.data) || request.resource.data.caption.size() <= 500)
        && (!('weather' in request.resource.data)
          || request.resource.data.weather in ['sunny','cloudy','rain','cold','wind','night']);
      allow delete: if auth() && resource.data.uid == request.auth.uid;

    }
    match /partnerRequests/{id} {
      allow read: if president() || (auth() && resource.data.uid == request.auth.uid);
      allow create: if auth() && request.resource.data.uid == request.auth.uid;
      allow update: if president() || (auth() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userName','contactEmail','message','deletedUser'])
        && request.resource.data.userName == 'Compte supprimé'); allow delete: if false;
    }
    match /users/{uid}/badges/{badgeId} {
      // Les badges sont des trophées publics (affichés sur le profil visiteur) :
      // ils restent lisibles, mais ne contiennent aucune donnée personnelle.
      allow read: if auth();
      allow create, update: if self(uid) && request.resource.data.badgeId == badgeId;
      allow delete: if self(uid);
    }
    match /activityFeed/{id} {
      // Coût : 0. Le fil est déjà filtré côté client (amis uniquement, blocages
      // retirés par la liste d'amis) ; la règle ne peut pas lire un tiers par
      // ligne sans faire refuser la requête au 11e élément.
      allow read: if auth() && (!resource.data.keys().hasAny(['audience']) || resource.data.audience == 'friends');
      allow create: if auth() && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is number
        && request.resource.data.message.size() <= 300;
      allow update, delete: if auth() && resource.data.uid == request.auth.uid;
    }
    match /friendChallenges/{id} {
      allow read: if auth() && request.auth.uid in resource.data.participants && !blocked(request.auth.uid, resource.data.creatorUid);
      allow create: if auth() && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.participants[0] == request.auth.uid
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 6
        && participantsAllowed(request.resource.data.participants)
        && request.resource.data.target is number;
      // F08 — champs modifiables explicitement limités : l'identité, la cible
      // et la récompense d'un défi ne peuvent plus être réécrites après
      // création par n'importe quel participant.
      allow update: if auth() && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','participants','participantNames','invitedUids','endsAt'
        ])
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.target == resource.data.target
        && request.resource.data.status in ['active','completed']
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 6;
      allow delete: if auth() && resource.data.creatorUid == request.auth.uid;
    }
    match /directMessages/{id} {
      // Coût : 0. `fromBlocked` est posé à l'envoi ; la conversation se ferme
      // ensuite par les règles d'écriture (`canInteract`).
      allow read: if auth() && request.auth.uid in [resource.data.from, resource.data.to]
        && (!('fromBlocked' in resource.data) || !resource.data.fromBlocked);
      allow create: if auth() && request.resource.data.from == request.auth.uid
        && canInteract(request.resource.data.from, request.resource.data.to)
        && (!('fromBlocked' in request.resource.data) || request.resource.data.fromBlocked == false)
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      // F08 — seul le destinataire peut marquer comme lu ; le contenu d'un
      // message ne peut pas être réécrit après envoi.
      allow update: if auth() && request.auth.uid == resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if auth() && request.auth.uid in [resource.data.from, resource.data.to];
    }
    match /communityEvents/{id} {
      allow read: if auth();
      allow create: if auth() && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.description.size() <= 600
        && (!('maxParticipants' in request.resource.data) || request.resource.data.maxParticipants == null
          || (request.resource.data.maxParticipants is int && request.resource.data.maxParticipants >= 2 && request.resource.data.maxParticipants <= 500));
      allow update: if auth() && (
        (resource.data.creatorUid == request.auth.uid
          && request.resource.data.creatorUid == resource.data.creatorUid
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.status in ['scheduled','cancelled'])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants','waitlist'])
          && request.resource.data.creatorUid == resource.data.creatorUid
          && canInteract(request.auth.uid, resource.data.creatorUid)
          && validEventMembership(resource.data, request.resource.data, request.auth.uid)
          && request.resource.data.participants.size() <= 500
          && request.resource.data.waitlist.size() <= 500
          && (!resource.data.keys().hasAny(['status']) || request.resource.data.status != 'cancelled')
        ));
      allow delete: if auth() && resource.data.creatorUid == request.auth.uid;
    }
    match /eventNotifications/{id} {
      allow read: if auth() && resource.data.toUid == request.auth.uid;
      allow create: if auth()
        && get(/databases/$(database)/documents/communityEvents/$(request.resource.data.eventId)).data.creatorUid == request.auth.uid
        && request.resource.data.toUid in get(/databases/$(database)/documents/communityEvents/$(request.resource.data.eventId)).data.participants
        && request.resource.data.type in ['updated','cancelled'] && request.resource.data.notified == false;
      allow update, delete: if false;
    }
    match /savedRoutes/{id} {
      allow read: if auth() && (resource.data.uid == request.auth.uid || (resource.data.visibility == 'public' && !blocked(request.auth.uid, resource.data.uid)));
      allow create: if auth() && request.resource.data.uid == request.auth.uid
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.description.size() <= 500
        && request.resource.data.points.size() >= 2 && request.resource.data.points.size() <= 5000
        && request.resource.data.visibility in ['private','public'];
      allow update: if auth() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points.size() <= 5000
        && request.resource.data.visibility in ['private','public'];
      allow delete: if auth() && resource.data.uid == request.auth.uid;
    }
    match /partnerOffers/{id} { allow read: if auth(); allow write: if president(); }
    match /establishments/{id} { allow read: if auth(); allow write: if president(); }
    match /{document=**} { allow read, write: if false; }
  }
}
