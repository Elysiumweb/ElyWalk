rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{fileName} {
      function ownsFile() { return request.auth != null && (fileName == request.auth.uid || fileName == request.auth.uid + '.jpg'); }
      allow read: if request.auth != null;
      allow create, update: if ownsFile() && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsFile();
    }
  }
}
