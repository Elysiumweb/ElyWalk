{
  "name": "elywalk",
  "private": true,
  "version": "2.1.3",
  "description": "ElyWalk - Application de comptage de pas récompensée en ElyCoins (Elysium)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:android": "npx cap sync android",
    "cap:open": "npx cap open android",
    "expo": "node scripts/preview.js",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --config ../firebase.json --only firestore --project elywalk-security-tests 'vitest run --config vitest.rules.config.ts'"
  },
  "dependencies": {
    "@capacitor-community/play-integrity": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.0",
    "@capgo/capacitor-pedometer": "^8.0.38",
    "@fontsource/orbitron": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "firebase": "^12.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.35.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
