<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Sécurité des données : « Applis installées » (refus Play du build 20103).
        Cette application ne déclare AUCUNE permission d'accès global aux
        applications installées (ni 'QUERY_ALL_PACKAGES', ni bloc '<queries>') :
        la liste est fournie par le SDK publicitaire fusionné depuis l'AAR
        'com.unity3d.ads-mediation:mediation-sdk' (LevelPlay / ironSource), qui
        appelle 'PackageManager.getInstalledApplications'. Ce comportement est
        déclaré dans Play Console (« Activité dans les applis → Applis
        installées ») et décrit au § 4.1 de 'public/privacy.html', affiché dans
        l'écran de consentement publicitaire. Toute réintroduction d'une
        permission de visibilité des paquets doit être justifiée ici.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!-- Rendu matériel (vidéos) requis par les SDK publicitaires servis par
             LevelPlay (dont Meta Audience Network) : activé sur l'application
             entière, pas seulement sur l'activité. Les activités et le provider
             du SDK LevelPlay sont fusionnés depuis l'AAR 'mediation-sdk'. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="elywalk" android:host="referral" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="elywalk-2f7ba.web.app" />
                <data android:scheme="https" android:host="elywalk-2f7ba.firebaseapp.com" />
            </intent-filter>

        </activity>

        <!-- Comptage de pas en arrière-plan (app fermée / écran éteint) -->
        <service
            android:name=".StepCounterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health"
            android:stopWithTask="false" />

        <!-- Sortie GPS en arrière-plan : trace le parcours même app fermée -->
        <service
            android:name=".TrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

        <receiver
            android:name=".ElyWalkWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_steps_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- LevelPlay : détection du réseau avant toute requête d'annonce. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Identifiant publicitaire (AAID) : requis par LevelPlay et par Meta
         Audience Network sur Android 13+. Déclaré explicitement ici plutôt que
         de dépendre du seul manifeste fusionné des play-services : la
         déclaration Play « utilisation de l'identifiant publicitaire » en
         dépend, et une version ciblant Android 13+ sans cette autorisation
         serait bloquée. L'identifiant n'est lu qu'après consentement. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Comptage de pas : capteur système (Activité physique) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <!-- Service de premier plan pour compter les pas app fermée -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Service de premier plan pour la sortie GPS en arrière-plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rappels programmés à heure fixe (rappels de marche, rappel de sortie).
         Sans ces autorisations, Android 12+ peut repousser ou supprimer
         l'alarme et la notification n'apparaît jamais. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Carte interactive : localisation -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
