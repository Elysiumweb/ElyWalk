<?xml version="1.0" encoding="utf-8"?>
<!--
  Bandeau natif compact (placement « Native banner »).
  Aucun visuel de création n'est utilisé pour ce format : icône, titre, contexte
  social et bouton d'action uniquement, conformément aux règles Meta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <com.facebook.ads.MediaView
        android:id="@+id/meta_ad_icon"
        android:layout_width="44dp"
        android:layout_height="44dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/meta_ad_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F5F1E6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meta_ad_social_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#98948A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/meta_ad_sponsored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6E6A62"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ad_choices_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/meta_ad_cta"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="88dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="#D8CA82"
            android:textColor="#111111"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
