<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Thème appliqué par Capacitor à la WebView.

      Affichage de bord à bord : il est activé par
      MainActivity.enableEdgeToEdgeCompat() via WindowCompat.enableEdgeToEdge()
      (androidx.core 1.17.0), l'API recommandée par Google.

      ⚠️ Aucune couleur de barre système n'est déclarée ici : depuis Android 15,
      `android:statusBarColor`, `android:navigationBarColor` (et
      `android:enforceStatusBarContrast` / `android:enforceNavigationBarContrast`)
      sont dépréciés et sans effet — Google Play les signale comme
      « API ou paramètres obsolètes pour l'affichage de bord à bord ».
      Les barres sont désormais transparentes par défaut.

      Le fond de fenêtre reprend le noir de l'application pour éviter tout
      flash blanc au lancement.
    -->
    <style name="AppTheme.NoActionBarBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/elywalkBackground</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Interface sombre : icônes claires dans les barres système. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme.NoActionBarBase" />

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
