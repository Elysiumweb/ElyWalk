{
	"appId": "com.elysium.elywalk",
	"appName": "ElyWalk",
	"webDir": "dist",
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"SystemBars": {
			"insetsHandling": "css",
			"style": "DARK",
			"hidden": false
		},
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com"
			]
		}
	}
}
