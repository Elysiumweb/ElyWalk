# ─────────────────────────────────────────────────────────────
# ElyWalk — variables d'environnement (front, préfixe VITE_)
# Copiez ce fichier en `.env` (ou `.env.local`) et complétez.
# ⚠️ Ces valeurs sont publiques (embarquées dans le bundle).
# ─────────────────────────────────────────────────────────────

# --- Config Firebase (facultatif : des valeurs par défaut existent) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# App ID de l'application Android (console Firebase > Paramètres > Vos applications)
# VITE_FIREBASE_ANDROID_APP_ID=1:260136634782:android:791d77945d9cd98b306e8f
# App ID de l'application *Web* — obligatoire si vous servez l'app dans un navigateur
# VITE_FIREBASE_WEB_APP_ID=1:260136634782:web:xxxxxxxxxxxxxxxx

# --- App Check ---
# Clé de site reCAPTCHA v3 (App Check > application Web).
# Sans cette clé, App Check n'est PAS initialisé sur le web (les requêtes
# seront refusées si l'application forcée est activée dans la console).
# VITE_APP_CHECK_RECAPTCHA_SITE_KEY=

# Jeton de debug App Check pour le développement en navigateur.
# Mettre `true` pour qu'un jeton soit généré et affiché dans la console,
# puis l'enregistrer dans Firebase Console > App Check > Jetons de débogage.
# VITE_APP_CHECK_DEBUG_TOKEN=true
